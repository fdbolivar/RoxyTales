# RoxyTales Backend Environment Configuration
# Copy this file to .env and adjust values for your local test environment.

# Test & Integration Flags (Stripe & Gelato POD are deferred to a later release)
TEST_MODE="true"
STRIPE_ENABLED="false"
GELATO_ENABLED="false"

# Optional Google GenAI Key (leave empty to test 100% locally with sprite compositing)
GEMINI_API_KEY="tu_gemini_key_aqui"

# Model Router Configuration
ROXY_PREVIEW_MODEL="gemini-2.5-flash-image"
ROXY_FINAL_MODEL="gemini-3-pro-image"
ROXY_PREVIEW_RESOLUTION="1K"
ROXY_FINAL_RESOLUTION="2K"
ROXY_TEST_PREVIEW_MODE="true"
ROXY_SCENE_MODE="fast_composite"

# Server Port
PORT=8000

# Optional Odoo 20 Sandbox Integration (Server-side ONLY — never expose in frontend JS)
ODOO_URL="https://edu-fdba.odoo.com"
ODOO_API_KEY="tu_api_key_odoo_aqui"
ODOO_ENV="sandbox"
ODOO_TEST_PREFIX="[RT-SANDBOX]"
ODOO_DOCUMENTS_FOLDER_NAME="RoxyTales Sandbox PDFs"
ODOO_MAIL_TEMPLATE_NAME="RoxyTales: Entrega Digital de Cuento Personalizado"
